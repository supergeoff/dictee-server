# Gardien du service conversation : seule la requête portant la clé passe, le reste reçoit 401.
# Aucun journal d'accès, pour que l'en-tête Authorization n'apparaisse nulle part.
:8080 {
	@authorized header Authorization "Bearer {$CONVERSATION_GATE_KEY}"

	handle @authorized {
		reverse_proxy conversation:8765
	}

	handle {
		respond 401
	}
}
